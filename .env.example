# Mahalliy sinov: npm run setup:test, keyin npm run dev:test
# Ommaviy reklama davri: batafsil REKLAMA-REJIMI.md
PROMO_MODE=true
ALLOW_GUEST_LOGIN=false
# Google + Telegram: AUTH-SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ixtiyoriy bepul davr tugash vaqti (Toshkent +05:00). Kirish usullariga ta'sir qilmaydi.
# PROMO_ENDS_AT=2026-11-12T23:59:59+05:00
ADMIN_LOGIN=ofis
# Quyidagi hash so'ralgan "ijara" paroli uchun. Ommaviy sayt uchun kuchli parolga almashtiring.
ADMIN_PASSWORD_HASH=scrypt:506ea7ac8176637676a752f3002350b6:02d24b2f74c692a152ea8b6f58f3731517836fd1e28f374e6f6efc64f4c7c6bcf337aab0df42dc595b8fcdb331a57577f89927233fb9651bae530ab6ccd8bc97
# Production uchun APP_MODE=test ni ishlatmang.
# APP_MODE=test
# Majburiy
DATABASE_URL=postgres://ofisijara:devpass@localhost:5432/ofisijara
SESSION_SECRET=kamida-32-belgili-tasodifiy-satr-bilan-almashtiring
APP_URL=http://localhost:3000

# Telegram bot orqali kirish (tavsiya etiladi). @BotFather orqali bot yarating, token oling.
# TELEGRAM_WEBHOOK_SECRET: o'zingiz yaratgan tasodifiy satr (A-Z a-z 0-9 _ -, 32+ belgi). Uchalasi ham bo'lmasa Telegram kirish o'chiq.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=     # @ belgisiz, masalan: OfisTopBot
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_API_BASE=       # FAQAT avtomatik testlar uchun (soxta server). Production'da o'rnatmang.

# LEGACY: SMS endpointlari o'chirilgan. Quyidagi Eskiz sozlamalari endi kirishni yoqmaydi.
# Amaldagi Google/Telegram sozlamalari: AUTH-SETUP.md.
# Faqat eski SMS adapteri va uning testlari uchun saqlangan.
SMS_PROVIDER=            # eskiz
ESKIZ_EMAIL=             # Eskiz kabinetiga kirish email'i
ESKIZ_PASSWORD=          # Eskiz kabinetidagi API kaliti (secret key)
ESKIZ_FROM=4546          # jo'natuvchi nomi; o'z nomingiz (nickname) tasdiqlangach shuni yozing
# SMS matni. Eskiz'da AYNAN shu matn shabloni moderatsiyadan o'tgan bo'lishi shart, aks holda SMS rad etiladi.
# SMS_OTP_TEMPLATE=OfisTop: tasdiqlash kodi {code}. Kodni hech kimga bermang.
# SMS_DAILY_LIMIT=500    # butun sayt bo'yicha sutkalik SMS chegarasi (byudjetni himoya qiladi)
# ESKIZ_CALLBACK_URL=    # ixtiyoriy: yetkazish holati uchun (hozir qayta ishlanmaydi)
# ESKIZ_API_BASE=        # FAQAT avtomatik testlar uchun. Production'da o'rnatmang.

# Eski test SMS sozlamasi; ommaviy SMS endpointlari o'chirilgan.
DEV_OTP_ENABLED=false

# Rasm saqlash: local (disk) yoki s3 (adapter hali ulanmagan)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Xarita tile provayderi (ixtiyoriy). Standart: OpenStreetMap rasmiy serveri — faqat kam yuklama uchun.
# Production'da o'z tile xizmatingizni ko'rsating va uning attribution talabiga rioya qiling.
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors
